{% extends "base.jinja2" %}

{% block title %}Error - Chutes{% endblock %}

{% block content %}
<h1>Authentication Error</h1>

<div class="error-message">
    <strong>{{ error }}</strong>
    {% if error_description %}
    <p style="margin-top: 8px;">{{ error_description }}</p>
    {% endif %}
</div>
{% endblock %}
