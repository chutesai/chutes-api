# TEE Measurement Configuration Example
# This file should be used to create the Kubernetes ConfigMap
#
# Usage:
#   kubectl create configmap tee-measurements --from-file=tee_measurements.yaml=./config/tee_measurements.yaml.example
#
# Or update the ConfigMap:
#   kubectl create configmap tee-measurements --from-file=tee_measurements.yaml=./config/tee_measurements.yaml.example --dry-run=client -o yaml | kubectl apply -f -
#
# Structure: one entry per VM version. MRTD/RTMR1/RTMR2 (firmware, kernel/initrd) and
# runtime_rtmr3 (runtime guest measure) are shared across all hardware for a version. Only
# RTMR0 (GPU topology) varies per hardware variant. Boot RTMR3 is implicitly all-zeros (it
# cannot be extended until runtime), so it is not configured here. Each version must be unique
# (stored on attestation for audit trail).
#
# Set `rc: true` on a version to mark it a release candidate / actively-tested build: it is
# still accepted for attestation, but excluded from the public GET /tee/measurements endpoint
# and from the tee_minimum_boot_version fallback (so it cannot lock out released VMs).

measurements:
  # Example: VM version 1.3.0, available on two hardware topologies.
  - version: "1.3.0"
    mrtd: "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6"
    rtmr1: "C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6"
    rtmr2: "D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1"
    runtime_rtmr3: "F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3"
    # rc: true   # uncomment to mark this version a release candidate (attestable, unpublished)
    hardware:
      # Only RTMR0 differs between hardware topologies.
      - name: "8xh200"
        rtmr0: "B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6"
        expected_gpus:
          - "h200"
        gpu_count: 8
      - name: "8xb200"
        rtmr0: "1A2B3C4D5E6F1A2B3C4D5E6F1A2B3C4D5E6F1A2B3C4D5E6F1A2B3C4D5E6F1A2B3C4D5E6F1A2B3C4D5E6F1A2B3C4D5E6F"
        expected_gpus:
          - "b200"
        gpu_count: 8
